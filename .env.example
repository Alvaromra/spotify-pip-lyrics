# Client ID do app criado em https://developer.spotify.com/dashboard
#
# Nao existe mais Client Secret neste projeto: o login usa Authorization Code
# com PKCE, que dispensa segredo. O Client ID e publico, aparece na URL de
# autorizacao e pode ser commitado direto em client/electron/config.cjs.
#
# Em desenvolvimento voce pode exportar a variavel em vez de editar o arquivo:
#   export SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_ID=

# Cadastre este Redirect URI, identico, no dashboard do Spotify:
#   http://127.0.0.1:8888/callback
